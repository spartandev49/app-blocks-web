{
  "name": "app-blocks-web",
  "version": "0.2.0",
  "description": "An LLM-native compact language and zero-dependency compiler for complete websites and web applications.",
  "type": "module",
  "types": "./src/index.d.ts",
  "bin": {
    "appblocks": "./bin/appblocks.js",
    "appblocks-v2": "./bin/appblocks-v2.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./catalog": "./src/generation2.js",
    "./generation2": "./src/generation2.js",
    "./runtime": "./src/runtime.js",
    "./styles": "./src/appblocks.css"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "docs",
    "examples",
    "LLMS.txt",
    "LLMS-COMPACT.txt",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build:showcase": "node ./bin/appblocks.js build ./examples/showcase.appblocks --out ./public",
    "build:generation2": "node ./bin/appblocks-v2.js build ./examples/generation2-showcase.ab --out ./.appblocks-generation2 --strict",
    "check": "node ./scripts/check-syntax.js",
    "test": "node --test",
    "test:generation2": "node --test ./test/generation2.test.js ./test/generation2-token-budget.test.js ./test/generation2-cli.test.js ./test/generation2-release.test.js",
    "benchmark": "node ./scripts/benchmark.js",
    "audit": "node ./scripts/static-audit.js",
    "verify": "npm run check && npm test && npm run audit && npm run build:showcase && npm run build:generation2 && npm run benchmark",
    "prepack": "npm run verify"
  },
  "keywords": [
    "llm",
    "ai",
    "dsl",
    "design-system",
    "component-library",
    "website-builder",
    "static-site-generator",
    "code-generation"
  ],
  "author": "spartandev49",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spartandev49/app-blocks-web.git"
  },
  "bugs": {
    "url": "https://github.com/spartandev49/app-blocks-web/issues"
  },
  "homepage": "https://github.com/spartandev49/app-blocks-web#readme",
  "publishConfig": {
    "access": "public"
  }
}
