{
  "name": "app-blocks-web",
  "version": "0.4.0",
  "description": "An LLM-native compact language and deterministic Taste Engine for complete, visually distinct, animated websites and web applications.",
  "type": "module",
  "types": "./src/index-v5.d.ts",
  "bin": {
    "appblocks": "./bin/appblocks.js",
    "appblocks-v2": "./bin/appblocks-v2.js"
  },
  "exports": {
    ".": {
      "types": "./src/index-v5.d.ts",
      "import": "./src/index.js"
    },
    "./catalog": "./src/generation2.js",
    "./generation2": "./src/generation2.js",
    "./motion": {
      "types": "./src/motion3.d.ts",
      "import": "./src/motion3.js"
    },
    "./runtime": "./src/runtime.js",
    "./styles": "./src/appblocks.css",
    "./taste": {
      "types": "./src/taste5.d.ts",
      "import": "./src/taste5.js"
    },
    "./motion5": {
      "types": "./src/motion5.d.ts",
      "import": "./src/motion5.js"
    }
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "docs",
    "examples",
    "LLMS.txt",
    "LLMS-COMPACT.txt",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    ".agents",
    "LLMS-TASTE.txt",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:showcase": "node ./bin/appblocks.js build ./examples/showcase.appblocks --out ./public",
    "build:generation2": "node ./bin/appblocks-v2.js build ./examples/generation2-showcase.ab --out ./.appblocks-generation2 --strict",
    "build:motion": "node ./bin/appblocks-v2.js build ./examples/motion-showcase.ab --out ./.appblocks-motion --strict",
    "check": "node ./scripts/check-syntax.js",
    "test": "node --test",
    "test:generation2": "node --test ./test/generation2.test.js ./test/generation2-token-budget.test.js ./test/generation2-cli.test.js ./test/generation2-release.test.js ./test/motion3.test.js",
    "test:motion": "node --test ./test/motion3.test.js",
    "benchmark": "node ./scripts/benchmark.js",
    "audit": "node ./scripts/static-audit.js",
    "verify": "npm run check && npm test && npm run audit && npm run build:showcase && npm run build:generation2 && npm run build:motion && npm run build:taste && npm run audit:taste && npm run benchmark",
    "prepack": "npm run verify",
    "build:taste": "node ./bin/appblocks-v2.js build ./examples/taste-showcase.ab --out ./.appblocks-taste --strict --taste-strict",
    "test:taste": "node --test ./test/taste5.test.js ./test/motion5.test.js ./test/taste5-cli.test.js ./test/taste5-release.test.js",
    "audit:taste": "node ./scripts/taste-audit.js"
  },
  "keywords": [
    "llm",
    "ai",
    "dsl",
    "design-system",
    "component-library",
    "animation",
    "motion-design",
    "website-builder",
    "static-site-generator",
    "code-generation",
    "anti-slop",
    "visual-design",
    "taste-engine",
    "design-variance"
  ],
  "author": "spartandev49",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spartandev49/app-blocks-web.git"
  },
  "bugs": {
    "url": "https://github.com/spartandev49/app-blocks-web/issues"
  },
  "homepage": "https://spartandev49.github.io/app-blocks-web/",
  "publishConfig": {
    "access": "public"
  }
}
