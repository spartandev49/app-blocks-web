{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spartandev49/app-blocks-web/schemas/build-manifest.schema.json",
  "title": "AppBlocks Web build manifest",
  "type": "object",
  "required": ["format", "version", "engine", "project", "base", "pages", "files", "blocks", "source", "output"],
  "properties": {
    "format": { "const": "appblocks-web-build" },
    "version": { "const": 1 },
    "engine": { "type": "string" },
    "project": { "type": "string" },
    "base": { "type": "string", "pattern": "^/.*/$|^/$" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route", "file", "title"],
        "properties": {
          "route": { "type": "string", "pattern": "^/" },
          "file": { "type": "string" },
          "title": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "blocks": {
      "type": "object",
      "required": ["total", "counts"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
      }
    },
    "source": { "$ref": "#/$defs/size" },
    "output": {
      "allOf": [
        { "$ref": "#/$defs/size" },
        { "type": "object", "required": ["expansionRatio"], "properties": { "expansionRatio": { "type": "number", "exclusiveMinimum": 0 } } }
      ]
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "required": ["bytes", "estimatedTokens"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1 },
        "estimatedTokens": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
