st "Northstar" r=r7314 p=p12 f=f084 s=s07 sf=u03 mo=m11
  pg "/" title="Northstar"
    hr017
      eye "Operations platform"
      ttl "Operate without the busywork" lvl=1
      txt "A complete responsive interface from a compact, deterministic source file."
      stk a=center
        b203 "Start now" h="/start"
        b118 "See the system" h="#system"
    sc247 id="system"
      ttl "A broader interface vocabulary" lvl=2
      txt "Generated choices remain semantic because every virtual block normalizes into a validated canonical contract."
      gr v=three
        cd014
          ttl "Recipe-driven" lvl=3
          txt "One short recipe selects a coordinated palette, type system, geometry, material, motion, density and elevation."
        cd375
          ttl "Model-efficient" lvl=3
          txt "Compact aliases and generated identifiers keep authored output small without shrinking the generated application."
        cd728
          ttl "Still validated" lvl=3
          txt "The established parser, validator and renderer remain responsible for correctness and accessible HTML."
    sc511
      ttl "Interactive patterns" lvl=2
      carousel
        slide
          ttl "Generated carousel" lvl=3
          txt "Previous and next controls are added by the dependency-free runtime."
        slide
          ttl "Viewport motion" lvl=3
          txt "Reveal, stagger and parallax respect reduced-motion preferences."
        slide
          ttl "Application controls" lvl=3
          txt "Dialogs, tabs, forms and data tables retain their existing tested behavior."
    call v=split
      ttl "Build the full interface" lvl=2
      txt "Use exact recipes where useful, then spend model tokens on the product logic that makes the site valuable."
      b907 "Create a project" h="/start"
