st "Aperture" r=d6421 lang=en base=/
  m description="A compact two-route product site demonstrating virtual blocks, design recipes and local interactions."
  hd107 logo=Aperture sticky=true theme-toggle=true
    nv label="Primary navigation"
      l "System" hr="/#system"
      l "Patterns" hr="/#patterns"
      l "Workspace" hr="/app/"
    b286 "Open workspace" hr="/app/" ico=arrow
  ft214 logo=Aperture note="A fictional interface generated by AppBlocks Web."
    nv label="Product"
      l "Design system" hr="/#system"
      l "Workspace" hr="/app/"
    tx "10,000 deterministic recipes; no duplicated implementation code."

  pg "/" title="Aperture — a complete interface from compact blocks"
    h731
      ey "Combinatorial interface engine"
      ti "Small source. Serious websites." level=1
      tx "Aperture demonstrates how compact semantic instructions expand into responsive typography, layouts, motion and accessible local interactions." size=large
      b286 "Inspect the patterns" hr="/#patterns" ico=arrow
      b407 "Open the workspace" hr="/app/"
      browser-frame
        cb label="aperture.appblocks" variant=dark
          code "st \"Aperture\" r=d6421"
    fs id=system variant=bento
      ey "One recipe coordinates the whole surface"
      ti "Typography, color, shape, depth and motion stay coherent."
      f091 ico=layers span=7
        ti "Design recipes"
        tx "Each d0000–d9999 recipe resolves to a tested combination of palette, font pairing, visual system, shape, surface, density, shadow and motion."
      f615 ico=code span=5
        ti "Compact aliases"
        tx "Models can author st, pg, h731 and b286 instead of repeating implementation details."
      f872 ico=shield span=12
        ti "Safe runtime behavior"
        tx "Interactive behavior comes from an allowlisted runtime rather than arbitrary generated JavaScript."
    sc id=patterns variant=paper
      ey "Functional patterns"
      ti "Advanced controls remain ordinary semantic blocks."
      carousel id=pattern-carousel autoplay=4200
        slide
          bd "Carousel" variant=accent
          ti "Keyboard-aware slides" level=3
          tx "Previous and next controls, live status, focus management and paused autoplay are supplied by the runtime."
        slide
          bd "Drawer" variant=success
          ti "Focused side panels" level=3
          tx "Drawers include a backdrop, Escape handling, focus return and a contained tab sequence."
        slide
          bd "Command palette" variant=warning
          ti "Fast keyboard navigation" level=3
          tx "Command surfaces open with Control or Command plus K and remain usable without a framework."
      b442 "Open component drawer" act=drawer:component-drawer ico=plus
      drawer id=component-drawer
        ti "Component controls" level=2
        tx "These controls are local demonstration behavior."
        range name=density label="Interface density" min=70 max=130 value=100
        file-drop name=assets label="Drop interface assets" multiple=true
        switch name=motion label="Enable motion" checked=true
        b118 "Close drawer" act=close-drawer
      command-palette id=command-menu
        search-box name=command-search label="Search commands" ph="Type a command"
        sk
          b032 "Open workspace" hr="/app/"
          b033 "Review design system" hr="/#system"
    ss variant=cards
      counter value=10000 label="Design recipes"
      counter value=20000 label="Virtual block aliases"
      counter value=32 label="Accessible palettes"
      counter value=30 label="Font pairings"
    ct355
      ey "Compiler-owned quality"
      ti "Give a smaller model better building material."
      tx "The model chooses content and intent. AppBlocks supplies the difficult responsive and interactive implementation."
      b286 "Open the application route" hr="/app/" ico=arrow

  pg "/app/" title="Aperture workspace" layout=app
    sh391
      sb logo=Aperture label="Workspace navigation"
        l "Overview" hr="/app/" ico=grid cur=true
        l "Components" hr="#components" ico=blocks
        l "Activity" hr="#activity" ico=trend
      tl
        ey "Generated application shell"
        ti "Interface inventory" level=1
        tx "Fictional data for interaction demonstration."
        b286 "New component" dlg=new-component ico=plus
      ms
        mt value="148" label="Semantic contracts" progress=82
        mt value="10K" label="Design recipes" progress=100
        mt value="20K" label="Virtual blocks" progress=100
      ts id=inventory-tabs label="Inventory views"
        t id=components label="Components" sel=true
          tb id=component-table label="Component inventory" filter=true sortable=true
            cl key=name label="Component"
            cl key=family label="Family"
            cl key=status label="Status"
            rw
              ce key=name "Command palette"
              ce key=family "Application"
              ce key=status
                bd "Ready" variant=success
            rw
              ce key=name "Carousel"
              ce key=family "Marketing"
              ce key=status
                bd "Ready" variant=success
            rw
              ce key=name "Drawer"
              ce key=family "Application"
              ce key=status
                bd "Ready" variant=success
        t id=activity label="Activity"
          ac label="Recent generated changes"
            ev time="Now" ico=spark
              tx "Design recipe d6421 applied to both routes."
            ev time="2m" ico=check
              tx "Strict validation completed without diagnostics."
      dg id=new-component title="New component"
        fm demo=true submit="Create component" success="Component fixture created"
          fd name=name label="Component name" req=true
          fd name=family label="Family" typ=select
            op "Marketing" value=marketing
            op "Application" value=application
